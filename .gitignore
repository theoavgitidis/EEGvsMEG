# CMake output directories (including build-vs and build-exp).
/gtec_Clib/terminal/build/
/gtec_Clib/terminal/build-*/
/gtec_Clib/terminal/out/

# Local Visual Studio state and Python caches.
.vs/
*.vcxproj.user
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local Python environments (MNE, ML, REVE).
.venv/
.venv-*/
venv/
venv-*/
env/
ENV/

# Local dependency/tool caches (also keep these outside cloud-synced folders).
.cache/
.tox/
.nox/
.ipynb_checkpoints/

# Downloaded ML weights, caches, and fitted model parameters.
/.ml-cache/
/analysis/results/**/checkpoints/

# Intermediate presentation renders and build files.
/.presentation-build/

# macOS Finder metadata.
.DS_Store
._*
.AppleDouble/
.LSOverride

# Cloud placeholder sidecars; ignoring these does not disable cloud syncing.
*.icloud

# Windows Explorer metadata.
Thumbs.db
Desktop.ini
